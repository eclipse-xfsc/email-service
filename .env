APP_NAME=email-service
ENV=dev
PORT=8080

NATS_URL=nats://nats:4222
NATS_QUEUE_GROUP=email-service
NATS_TOPIC_SEND=email.send
NATS_TOPIC_RECEIVE=email.receive

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

SMTP_DEFAULT_SENDER_EMAIL=test@this-is-a-test.com
SMTP_DEFAULT_SENDER_NAME=Tester
SMTP_DEFAULT_SUBJECT=Test Mail
SMTP_SUBJECT_LENGTH_MIN=5
SMTP_SUBJECT_LENGTH_MAX=255
